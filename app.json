{
  "expo": {
    "name": "Shelfly",
    "slug": "shelfly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shelfly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quvantic.shelfly",
      "associatedDomains": ["applinks:shelfly-app.quvantic.com"],
      "infoPlist": {
        "NSCameraUsageDescription": "Shelfly uses the camera to scan product barcodes on the warehouse floor."
      }
    },
    "android": {
      "package": "com.quvantic.shelfly",
      "adaptiveIcon": {
        "backgroundColor": "#1E3D32",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "shelfly-app.quvantic.com",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Shelfly",
      "shortName": "Shelfly",
      "themeColor": "#1E3D32",
      "backgroundColor": "#F4F0E6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E3D32",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Shelfly uses the camera to scan product barcodes on the warehouse floor.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C0632F",
          "icon": "./assets/images/notification-icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-4000-8000-000000000006"
      }
    }
  }
}
